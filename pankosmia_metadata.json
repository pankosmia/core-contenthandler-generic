      "id": "Simpan"
    },
    "about_to_export_burrito": {
      "en": "About to save this content as Burrito",
      "es": "A punto de guardar este contenido como Burrito"
    },
    "export_burrito": {
      "en": "Save as Burrito",
      "es": "Guardar como Burrito",
