{
  "id": "core-contenthandler-generic",
  "exclude_from_menu": true,
  "exclude_from_dashboard": true,
  "require": {
    "net": false,
    "debug": true,
    "minServerVersion": "0.16.1"
  },
  "endpoints": {
    "all": {
      "about_repo": [
        {
          "doc": "About repo all document",
          "placeHolders": {
            "REPO_PATH": {
              "doc": "The path to the repo in <X>/<Y>/<Z> format"
            }
          },
          "label": "pages:content:about_repo",
          "url": "/aboutRepo?repoPath=%%REPO_PATH%%"
        }
      ]
    },
    "x-bcvnotes": {
      "delete_book": [
        {
          "doc": "Delete a book to a bcv Notes document",
          "placeHolders": {
            "REPO_PATH": {
              "doc": "The path to the repo in <X>/<Y>/<Z> format"
            }
          },
          "label": "pages:core-contenthandler-generic:delete_book",
          "url": "/deleteBook?repoPath=%%REPO_PATH%%&type=tsv"
        }
      ]
    },
    "x-bcvquestions": {
      "delete_book": [
        {
          "doc": "Delete a book to a bcv Notes document",
          "placeHolders": {
            "REPO_PATH": {
              "doc": "The path to the repo in <X>/<Y>/<Z> format"
            }
          },
          "label": "pages:core-contenthandler-generic:delete_book",
          "url": "/deleteBook?repoPath=%%REPO_PATH%%&type=tsv"
        }
      ]
    },
    "textTranslation": {
      "delete_book": [
        {
          "doc": "Delete a book to a textTranslation document",
          "placeHolders": {
            "REPO_PATH": {
              "doc": "The path to the repo in <X>/<Y>/<Z> format"
            }
          },
          "label": "pages:core-contenthandler_text_translation:delete_book",
          "url": "/deleteBook?repoPath=%%REPO_PATH%%&type=usfm"
        }
      ],
      "export": [
        {
          "subMenu": [
            {
              "burrito": [
                {
                  "doc": "Export to burrito a textTranslation document",
                  "placeHolders": {
                    "REPO_PATH": {
                      "doc": "The path to the repo in <X>/<Y>/<Z> format"
                    }
                  },
                  "label": "pages:core-contenthandler-generic:saveAsBurrito",
                  "url": "/export/burrito?repoPath=%%REPO_PATH%%"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "i18n": {
    "title": {
      "en": "core-contenthandler-generic"
    },
    "summary": {
      "en": "core-contenthandler-generic"
    },
    "stub_content": {
      "en": "Content goes here"
    },
    "error_data": {
      "en": "Error fetching data",
      "fr": "Erreur lors de la récupération des données"
    },
    "close": {
      "en": "Close",
      "es": "Cerrar",
      "fr": "Fermer",
      "id": "Tutup"
    },
    "book_deleted": {
      "en": "Book deleted",
      "fr": "Livre supprimé"
    },
    "book_delete_error": {
      "en": "The book could not be deleted ",
      "fr": "Le livre ne peut pas être supprimé"
    },
    "book_code": {
      "en": "Book",
      "fr": "livre",
      "es": "Libro",
      "id": "@Kode Buku"
    },
    "delete_button": {
      "en": "Delete",
      "fr": "Supprimer"
    },
    "delete_book": {
      "en": "Delete Book",
      "fr": "Supprimer un livre"
    },
    "about_repo_copyright": {
      "en": "Copyright",
      "fr": "Droit d'auteur"
    },
    "saveAsBurrito": {
      "en": "Save as Burrito",
      "fr": "Sauvegarder Burrito"
    },
    "cancel": {
      "en": "Cancel",
      "es": "Cancelar",
      "fr": "Annuler",
      "id": "Batal"
    },
    "do_export": {
      "en": "Save",
